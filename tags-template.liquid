---
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - posts
permalink: /tags/{{ tag | slugify }}/
layout: page
renderData:
  title: "Posts getagged met '{{ tag }}'"
---

<h1>Posts getagged met "{{ tag }}"</h1>

<ul>
{% assign taglist = collections[ tag ] %}
{% for post in taglist reversed %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a> - {{ post.date | date: "%Y-%m-%d" }}
  </li>
{% endfor %}
</ul>

<p><a href="{{ site.url }}/tags/">Bekijk alle onderwerpen</a></p>
