          </a>
        </div>
      </div>
    </nav>
  </header>
  <script>
    (function() {
      const toggle = document.getElementById('nav-toggle');
      const container = document.getElementById('nav-container');
      if(toggle && container) {
        toggle.addEventListener('click', function() {
          const isOpen = container.classList.toggle('active');
          toggle.setAttribute('aria-expanded', String(isOpen));
        });
      }
    })();
  </script>

  <main{% if pageClass %} class="main--{{ pageClass }}"{% endif %}>
    {{ content }}
  </main>

  <footer class="site-footer">
    <p>&copy; {{ "now" | date: "%Y" }} {{ site.author.name }}. Alle rechten voorbehouden. Gemaakt met <a href="https://www.11ty.dev/">Eleventy</a></p>
  </footer>

  {% if site.analytics.goatcounter %}
  <script data-goatcounter="{{ site.analytics.goatcounter.endpoint }}"
        async src="{{ site.analytics.goatcounter.script }}"></script>
  {% endif %}
</body>
</html>
